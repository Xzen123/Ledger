# Port the API server listens on
PORT=4000

# Path to the SQLite database file (created automatically on first run)
DB_PATH=./data/liferpg.db

# Secret used to sign JWTs — replace with a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Optional: Google OAuth Client ID for token audience verification
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
