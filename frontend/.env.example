# Base URL of the deployed backend API (no trailing slash).
# In local dev, leave this unset — Vite proxies /api to localhost:4000.
VITE_API_URL=https://your-backend.onrender.com/api

# Google OAuth Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# When left empty, a one-click simulated Google account is enabled for frictionless local testing
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

